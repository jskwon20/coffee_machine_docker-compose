           <h2>📋 메뉴 조회</h2>\n                <button onclick=\"getMenu()\">메뉴 조회</button>\n                <div id=\"menuResult\" class=\"result\" style=\"display:none;\"></div>\n            </div>\n\n            <!-- 재고 조회 -->\n            <div class=\"section\">\n                <h2>📦 재고 조회</h2>\n                <button onclick=\"getInventory()\">재고 조회</button>\n                <div id=\"inventoryResult\" class=\"result\" style=\"display:none;\"></div>\n            </div>\n\n            <!-- 매출 조회 -->\n            <div class=\"section\">\n                <h2>💰 매출 조회</h2>\n                <button onclick=\"getSales()\">매출 조회</button>\n                <div id=\"salesResult\" class=\"result\" style=\"display:none;\"></div>\n            </div>\n        </div>\n\n        <!-- 주문 생성 -->\n        <div class=\"section\">\n            <h2>🛒 주문 생성</h2>\n            <div class=\"form-group\">\n                <label>메뉴 선택:</label>\n                <select id=\"orderMenuId\">\n                    <option value=\"1\">에스프레소 (3,000원)</option>\n                    <option value=\"2\">라떼 (4,000원)</option>\n                    <option value=\"3\">카푸치노 (4,500원)</option>\n                </select>\n            </div>\n            <div class=\"form-group\">\n                <label>수량:</label>\n                <input type=\"number\" id=\"orderQuantity\" value=\"1\" min=\"1\">\n            </div>\n            <div class=\"form-group\">\n                <label>지불 금액:</label>\n                <input type=\"number\" id=\"orderPayment\" value=\"5000\" step=\"1000\">\n            </div>\n            <button onclick=\"createOrder()\">주문하기</button>\n            <div id=\"orderResult\" class=\"result\" style=\"display:none;\"></div>\n        </div>\n\n        <!-- 재고 추가 -->\n        <div class=\"section\">\n            <h2>➕ 재고 추가</h2>\n            <div class=\"form-group\">\n                <label>재고 항목:</label>\n                <select id=\"inventoryItem\">\n                    <option value=\"coffee_beans\">커피빈 (100g당 3,000원)</option>\n                    <option value=\"milk\">우유 (100ml당 2,000원)</option>\n                    <option value=\"water\">물 (100ml당 1,000원)</option>\n                </select>\n            </div>\n            <div class=\"form-group\">\n                <label>추가 수량:</label>\n                <input type=\"number\" id=\"inventoryAmount\" value=\"100\" step=\"100\">\n            </div>\n            <button class=\"secondary\" onclick=\"addInventory()\">재고 추가</button>\n            <div id=\"addInventoryResult\" class=\"result\" style=\"display:none;\"></div>\n        </div>\n\n        <!-- Health Check -->\n        <div class=\"section\">\n            <h2>🏥 서비스 상태 확인</h2>\n            <button onclick=\"checkHealth()\">전체 상태 확인</button>\n            <div id=\"healthResult\" class=\"result\" style=\"display:none;\"></div>\n        </div>\n    </div>\n\n    <script>\n        const API_BASE = {\n            order: 'http://localhost:8000',\n            inventory: 'http://localhost:8001',\n            billing: 'http://localhost:8002'\n        };\n\n        function showResult(elementId, data, isError = false) {\n            const element = document.getElementById(elementId);\n            element.style.display = 'block';\n            element.style.borderLeftColor = isError ? '#f44336' : '#4CAF50';\n            element.innerHTML = `<pre>${JSON.stringify(data, null, 2)}</pre>`;\n        }\n\n        async function getMenu() {\n            try {\n                const response = await fetch(`${API_BASE.order}/menu`);\n                const data = await response.json();\n                showResult('menuResult', data);\n            } catch (error) {\n                showResult('menuResult', { error: error.message }, true);\n            }\n        }\n\n        async function getInventory() {\n            try {\n                const response = await fetch(`${API_BASE.inventory}/inventory`);\n                const data = await response.json();\n                showResult('inventoryResult', data);\n            } catch (error) {\n                showResult('inventoryResult', { error: error.message }, true);\n            }\n        }\n\n        async function getSales() {\n            try {\n                const response = await fetch(`${API_BASE.billing}/sales`);\n                const data = await response.json();\n                showResult('salesResult', data);\n            } catch (error) {\n                showResult('salesResult', { error: error.message }, true);\n            }\n        }\n\n        async function createOrder() {\n            try {\n                const menuId = parseInt(document.getElementById('orderMenuId').value);\n                const quantity = parseInt(document.getElementById('orderQuantity').value);\n                const payment = parseInt(document.getElementById('orderPayment').value);\n\n                const response = await fetch(`${API_BASE.order}/orders`, {\n                    method: 'POST',\n                    headers: { 'Content-Type': 'application/json' },\n                    body: JSON.stringify({\n                        menu_id: menuId,\n                        quantity: quantity,\n                        payment_amount: payment\n                    })\n                });\n\n                const data = await response.json();\n                showResult('orderResult', data, !response.ok);\n                \n                if (response.ok) {\n                    getInventory();\n                    getSales();\n                }\n            } catch (error) {\n                showResult('orderResult', { error: error.message }, true);\n            }\n        }\n\n        async function addInventory() {\n            try {\n                const item = document.getElementById('inventoryItem').value;\n                const amount = parseInt(document.getElementById('inventoryAmount').value);\n\n                const response = await fetch(`${API_BASE.inventory}/inventory/add`, {\n                    method: 'POST',\n                    headers: { 'Content-Type': 'application/json' },\n                    body: JSON.stringify({ item, amount })\n                });\n\n                const data = await response.json();\n                showResult('addInventoryResult', data, !response.ok);\n                \n                if (response.ok) {\n                    getInventory();\n                    getSales();\n                }\n            } catch (error) {\n                showResult('addInventoryResult', { error: error.message }, true);\n            }\n        }\n\n        async function checkHealth() {\n            try {\n                const services = ['order', 'inventory', 'billing'];\n                const results = {};\n\n                for (const service of services) {\n                    try {\n                        const response = await fetch(`${API_BASE[service]}/health`);\n                        const data = await response.json();\n                        results[`${service}-service`] = data;\n                    } catch (error) {\n                        results[`${service}-service`] = { status: 'error', message: error.message };\n                    }\n                }\n\n                showResult('healthResult', results);\n            } catch (error) {\n                showResult('healthResult', { error: error.message }, true);\n            }\n        }\n\n        // 페이지 로드 시 초기 데이터 조회\n        window.onload = () => {\n            getMenu();\n            getInventory();\n            getSales();\n        };\n    </script>\n</body>\n</html>\n",
